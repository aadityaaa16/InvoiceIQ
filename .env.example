# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env
#
# Hostnames below assume the API runs on your machine (uvicorn) while Postgres,
# Redis and SeaweedFS run in Docker. Inside docker-compose, the api/worker services
# override them with the service names (postgres, redis, seaweedfs).

# --- Application ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=invoiceiq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoiceiq

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate limits ---
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
UPLOAD_RATE_LIMIT=30/minute

# --- File storage (S3 API: SeaweedFS locally, any S3-compatible service elsewhere) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=invoiceiq
S3_SECRET_KEY=change-me-storage
S3_BUCKET=invoices
MAX_UPLOAD_SIZE_MB=10

# --- OCR (Windows: set these if Tesseract / Poppler are not on PATH) ---
OCR_PROVIDER=tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin

# --- LLM ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60

# --- Pipeline ---
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.90
AMOUNT_TOLERANCE=1.00
MAX_TASK_RETRIES=3
